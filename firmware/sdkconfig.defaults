# Target
CONFIG_IDF_TARGET="esp32p4"

# Flash：实机 ESP32-P4-WIFI6-Touch-LCD-3.5，16MB，DIO/80MHz（2026-09-12 实测）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM：实机为 APS 32MB 十六线（hex_psram 日志，2026-09-12 实测）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200MHZ=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# 主频（实测启动日志 360MHz）
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# FatFS：长文件名 + UTF-8（中文标题/SSID）
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y

# mbedTLS：证书校验必须开启
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# LVGL v9
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 实机芯片为 revision v1.3（2026-09-12 实测），支持 v3 以下修订
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# LVGL 用系统 malloc（PSRAM 堆），不用内置静态池（内部 SRAM 紧张，M0 实测）
CONFIG_LV_USE_STDLIB_MALLOC=y

# 允许 static .bss 放 PSRAM（EXT_RAM_BSS_ATTR 生效的前提）
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# LVGL 内存：用 C 库 malloc（走 PSRAM 堆），不用内置 64KB 静态池
CONFIG_LV_USE_CLIB_MALLOC=y

# M0 调试期：全面堆投毒定位越界写（量产前评估开销后决定去留）
CONFIG_HEAP_POISONING_COMPREHENSIVE=y

# main 任务栈加大：启动链（LCD/触摸/TF/音频/相机 bring-up）调用深度大，
# 3.5KB 默认值会栈溢出砸坏相邻堆（M0 实测）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# esp_hosted（C6 Wi-Fi 协处理器）必须在 app_main 前自动初始化，否则
# esp_wifi_init 失败（M0 实测：关闭此项会导致 network_init 报 "wifi init" 错误）
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=y

# LVGL 快照：UART 调试命令 screenshot 用（M0 实机诊断，量产前评估 Flash 开销）
CONFIG_LV_USE_SNAPSHOT=y

# 中文界面字体：LVGL 自带 SimSun CJK（M1 完整字库方案的起点，见实施计划 §4.3）
# 中文界面字体由 components/app_ui/fonts 提供（自生成，覆盖更全）
# CONFIG_LV_FONT_SIMSUN_14_CJK is not set
# CONFIG_LV_FONT_SIMSUN_16_CJK is not set

# 相机：OV5647 MIPI-CSI（实机为微雪 OV5647 模组；参考官方示例 09_video_lcd_display）
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# 相机 ISP 依赖（对照微雪官方可运行示例 09_video_lcd_display）：
# ISP 经 L2 缓存做 DMA，缓存容量/行宽必须匹配；experimental 解锁相关选项
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# IPA 使用 esp_cam_sensor 内置的 OV5647 默认 JSON（与微雪官方示例一致）；
# 曝光/增益由传感器片上 AEC 负责，camera_service 开流后调整帧长与防闪烁档位（见源码注释）
# TLS 记录保持默认 16KB：实机 2026-09-13 对比测试表明 multipart 腐蚀的
# 根因是请求体缓冲被提前 free（堆投毒 0xFE 填充被当请求体发出），与 TLS
# 记录大小无关；缩小 OUT 记录反而使上传产生更多 SDIO TX 缓冲需求，
# 在无聚合的 C6 兼容流模式下加剧 TX 池 OOM。

# esp_hosted SDIO 缓冲池警示：每缓冲 1536B 内部 DMA RAM，队列 20+20 约
# 61KB。曾试 60+60（184KB）导致内部 RAM 耗尽、硬件 AES 分配失败、TLS
# 全部失败（实机 2026-09-13）。TX OOM 为短暂现象，协议层会重传。

# TCP PCB 池：设备为每轮生成建立 7+ 短连接（POST/轮询/result/audio），
# 主动关闭方 TIME_WAIT 占用 PCB；默认 16 在几轮后耗尽（实机复现：
# 新连接 connect 必失败，重启后恢复）。
CONFIG_LWIP_MAX_ACTIVE_TCP=64

# 本地播放（FLOW-04）：MP3 简单解码器
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y

# TLS：公共根证书包 + 交叉签名链校验（Let's Encrypt 新链经 ISRG X1/X2 交叉签名验证）。
# 局域网自签名联调另见 README（开启 CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE）。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# 性能：-O2（LVGL 软件渲染等热点约快 1.3 倍；栈余量已按 tasks 命令复核）、
# LVGL 刷新周期 15 ms（与出厂一致）、任务状态查询（调试 tasks 命令看栈水位）
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# 默认后端地址（占位；可在 menuconfig 或设备"设置 → 服务器"修改）与设备令牌（见 README 配对说明）
CONFIG_STORY_SERVER_BASE_URL="https://story.example.com"
CONFIG_STORY_DEV_TOKEN=""

# 相机：OV5647 1280x960 RAW10 2x2 binning（全视场；camera_service 的旋转/裁切/降帧按此模式编写）
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
# CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS is not set
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y

# TLS 发送缓冲 16 KB（照片 multipart 上传）
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
