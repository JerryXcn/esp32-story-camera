# esp32-story-camera server 环境变量样例
# 复制为 .env.local 并填入真实密钥；.env.local 不要提交到任何仓库。

SC_DATA_DIR=./data
# 设备令牌（与固件 CONFIG_STORY_DEV_TOKEN 相同，32 位十六进制）：<token>:<设备名>，多台用逗号分隔
# 生成：python3 -c "import secrets; print(secrets.token_hex(16))"
SC_DEVICE_TOKENS=<32-hex-token>:my-story-camera

SC_PROVIDER_MODE=real            # real | mock

# 智谱开放平台（视觉理解 + 故事生成）
SC_BIGMODEL_API_KEY=
SC_BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SC_BIGMODEL_VISION_MODEL=glm-4.5v
SC_BIGMODEL_STORY_MODEL=glm-4.5v
# SC_BIGMODEL_STORY_INCLUDE_IMAGE=0   # 仅当故事模型为纯文本模型时设置

# 小米 MiMo 开放平台（TTS）
SC_MIMO_API_KEY=
SC_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
SC_MIMO_MODEL=mimo-v2.5-tts
SC_VOICE_MAP=warm_female_01:mimo_default

# 额度与保留
SC_QUOTA_PER_DEVICE_DAILY=50
SC_MEDIA_TTL_H=24
SC_DIGEST_TTL_D=7

# 超时
SC_ATTEMPT_DEADLINE_S=120
SC_PROVIDER_TIMEOUT_S=60
